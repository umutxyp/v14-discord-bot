{
  "name": "slash-command-bot",
  "version": "2.0.0",
  "description": "Sharded Discord bot template for discord.js v14 with unified slash + prefix commands and Components V2.",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/deploy.js && node src/bot.js",
    "deploy": "node src/deploy.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "slash-commands",
    "prefix-commands",
    "components-v2",
    "sharding"
  ],
  "author": "Umut Bayraktar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutxyp/slash-command-bot.git"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
