# ─── Required ────────────────────────────────────────────────────────────────
# Bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# ─── Prefix commands ─────────────────────────────────────────────────────────
# Prefix commands need "Message Content Intent" enabled in the Developer Portal (Bot tab).
# Set PREFIX_ENABLED=false to run a pure slash-command bot without that intent.
PREFIX_ENABLED=true
PREFIX=!

# ─── Optional ────────────────────────────────────────────────────────────────
# Comma separated user IDs that bypass cooldowns and can use ownerOnly commands.
OWNER_IDS=

# Register slash commands in a single guild for instant updates while developing.
# Leave empty to register globally.
DEV_GUILD_ID=

# Sync slash commands with Discord on every start (true/false).
DEPLOY_ON_START=true

# Number of shards: "auto" (recommended by Discord) or a fixed number.
TOTAL_SHARDS=auto

# Custom status text and accent color of the Components V2 cards.
BOT_STATUS=Umut Bayraktar ♥ /help
ACCENT_COLOR=#5865F2

# Health-check HTTP port for hosting platforms / uptime monitors (leave empty to disable).
PORT=
